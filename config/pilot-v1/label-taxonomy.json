        "requested",
        "pledged",
        "committed",
        "allocated",
        "mobilized",
        "disbursed",
        "spent",
        "not_stated"
      ],
      "finance_source": "Exact named fund, ministry, budget, bank, enterprise, donor, or other source; open text.",
      "finance_amount": "Numeric or textual amount plus currency/unit; preserve source figure and scope."
    },
    "number_rules": [
      "Never turn an observation, projection, or finance need into a target.",
      "Preserve exact wording and normalized values separately; unknown is null, never zero.",
      "Do not compare values until metric, unit, baseline, denominator, period, scope, scenario, and condition are compatible.",
      "Keep different target periods, support conditions, and quantitative variants separate."
    ]
  },
  "document_metadata": {
    "cardinality": "one_per_record",
    "fields": {
      "document_id": "stable corpus ID when available",
      "document_kind": [
