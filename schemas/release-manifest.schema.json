{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release-manifest v1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "country_code": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "no_documents_supplied"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "corpus_snapshot_id": {
      "type": "string"
    },
    "document_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "provider_route": {
          "type": "string"
        },
        "requested_model": {
          "type": "string"
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_effort": {
          "type": "string"
        },
        "confirmed_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_hash": {
          "type": "string"
        },
        "schema_hash": {
          "type": "string"
        },
        "taxonomy_hash": {
          "type": "string"
        }
      },
      "required": [
        "provider_route",
        "requested_model",
        "actual_model",
        "requested_effort",
        "confirmed_effort",
        "completed_at",
        "prompt_hash",
        "schema_hash",
        "taxonomy_hash"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "reviewer_id",
        "reviewed_at",
        "validation_receipt_id"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "pages_total": {
          "type": "integer",
          "minimum": 0
        },
        "pages_accounted_for": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable_pages": {
          "type": "integer",
          "minimum": 0
        },
        "translation_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "pages_total",
        "pages_accounted_for",
        "unreadable_pages",
        "translation_complete"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "relative_path",
          "sha256",
          "media_type"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "country_code",
    "availability",
    "run_id",
    "corpus_snapshot_id",
    "document_versions",
    "generation",
    "review",
    "coverage",
    "artifacts",
    "limitations"
  ],
  "additionalProperties": false
}
