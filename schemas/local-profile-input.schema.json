{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local country profile import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "country_code",
    "synthetic",
    "source_group_id",
    "provenance_note",
    "sources",
    "extraction",
    "report"
  ],
  "properties": {
    "format": {
      "const": "local-profile-1"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance_note": {
      "type": "string",
      "minLength": 1
    },
    "extraction": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "title",
          "path",
          "sha256",
          "country_code",
          "metadata_verified",
          "pages",
          "layout_checked",
          "segments"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "metadata_verified": {
            "type": "boolean"
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "layout_checked": {
            "type": "boolean"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "page",
                "language",
                "text",
                "english_text",
                "translation_method"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "language": {
                  "type": "string",
                  "minLength": 2
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "english_text": {
                  "type": "string",
                  "minLength": 1
                },
                "translation_method": {
                  "enum": [
                    "identity",
                    "machine_translation"
                  ]
                },
                "term_decisions": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "translation_notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "page_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "concerns",
                "review",
                "parsed_text_sha256"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "concerns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "review": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "parsed_text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "automatic": {
                  "type": "object",
                  "required": [
                    "page",
                    "source_sha256",
                    "text",
                    "text_sha256",
                    "status",
                    "method",
                    "notes",
                    "artifacts"
                  ],
                  "properties": {
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "text": {
                      "type": "string"
                    },
                    "text_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "status": {
                      "enum": [
                        "complete",
                        "partial",
                        "nontext",
                        "unreadable"
                      ]
                    },
                    "method": {
                      "enum": [
                        "existing_review",
                        "native",
                        "vision",
                        "alternate_parser",
                        "ocr",
                        "native_partial"
                      ]
                    },
                    "notes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "generation_step": {
                      "type": "object",
                      "required": [
                        "signature",
                        "result_hash"
                      ],
                      "properties": {
                        "signature": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "result_hash": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "additionalProperties": false
                    },
                    "artifacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "sha256"
                        ],
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "source_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "title",
          "sha256",
          "status",
          "pages",
          "issues"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unreadable"
            ]
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "issues": {
            "type": "array"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
