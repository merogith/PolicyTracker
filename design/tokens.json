{
  "version": "1.1.0-reader",
  "principle": "neutral reading surfaces, one accent, typography-led hierarchy; host branding can override component variables",
  "font_family": "system-ui, Segoe UI, sans-serif",
  "color": {
    "text": "#19383e",
    "muted": "#526b70",
    "accent": "#176b61",
    "surface": "#ffffff",
    "background": "#f5f7f6",
    "border": "#d5e0de",
    "soft": "#f1f7f6"
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "corner_radius_px": {
    "control": 7,
    "panel": 10
  },
  "body_text_px": 14,
  "touch_control_target_px": 44,
  "component_css_variables": [
    "--pt-text",
    "--pt-muted",
    "--pt-accent",
    "--pt-border",
    "--pt-surface",
    "--pt-soft"
  ],
  "restrictions": [
    "no color-only status",
    "no unsupported performance arrows",
    "no composite country score",
    "no nested dashboard cards for decoration",
    "no credential or implementation details in normal reading views"
  ]
}
