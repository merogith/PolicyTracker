        },
        {
          "id": "policy_or_action",
          "label": "Policy or action",
          "definition": "An adopted, existing, proposed, or described policy, measure, program, or activity; use the source status field below to preserve stage."
        },
        {
          "id": "commitment_or_target",
          "label": "Commitment or target",
          "definition": "A stated commitment, objective, quantitative target, or qualitative deliverable."
        },
        {
          "id": "implementation_update",
          "label": "Implementation update",
          "definition": "Reported funding, procurement, rollout, operation, or other implementation status."
        },
        {
          "id": "observed_result_or_impact",
          "label": "Observed result or impact",
          "definition": "Measured or reported condition, outcome, event impact, loss, or change."
        },
        {
          "id": "projection_or_scenario",
          "label": "Projection or scenario",
          "definition": "A future estimate conditional on a model, scenario, or stated assumptions."
        },
        {
          "id": "finance_information",
          "label": "Finance information",
          "definition": "Finance need, source, instrument, amount, allocation, mobilization, disbursement, or spending."
        },
        {
          "id": "barrier_or_constraint",
          "label": "Barrier or constraint",
          "definition": "A stated obstacle, limitation, trade-off, or implementation challenge."
        },
        {
          "id": "other",
          "label": "Other",
          "definition": "Useful information that does not fit the options; explain briefly."
        },
        {
          "id": "unclear",
          "label": "Unclear",
          "definition": "The statement type cannot be determined from available context; add a review note."
        }
      ]
    },
    "purpose": {
      "cardinality": "zero_or_more",
      "meaning": "The intended policy purpose explicitly supported by the source.",
      "values": [
        "adaptation",
        "mitigation",
        "disaster_risk_reduction",
        "loss_and_damage",
        "enabling_support"
      ],
      "rule": "Do not force a purpose when unstated; use an empty list."
    },
    "risk_component": {
      "cardinality": "zero_or_more",
      "values": [
        "hazard",
        "exposure",
        "vulnerability",
        "capacity",
        "impact",
        "systemic_or_cascading_risk"
      ],
      "rule": "Use only when the information explicitly concerns that component of risk."
    },
    "hazard_type": {
      "cardinality": "zero_or_more",
      "controlled_values": [
        "flood",
        "drought",
        "water_scarcity",
        "extreme_heat",
        "extreme_cold",
        "storm_or_high_wind",
        "heavy_precipitation",
        "wildfire",
        "landslide_or_mudslide",
        "erosion",
        "glacial_lake_outburst",
        "sea_level_rise",
        "coastal_hazard",
        "avalanche",
        "earthquake",
        "tsunami",
        "disease_or_biological_hazard",
        "technological_hazard",
        "compound_or_cascading_hazard"
      ],
      "open_value_rule": "If no controlled value fits, preserve the source term as {id:\"other\", source_term:\"...\"}. A hazard is not required for non-risk information."
    },
    "affected_group": {
      "cardinality": "zero_or_more_open_values",
      "examples": [
        "farmers",
        "herders",
        "fishers",
        "rural_communities",
        "urban_communities",
        "women",
        "children",
        "youth",
        "older_people",
        "persons_with_disabilities",
        "low_income_households",
        "workers",
        "indigenous_or_local_communities",
        "migrants_or_displaced_people"
      ],
      "rule": "Preserve source wording; normalize synonyms to a stable display term only when clear. Do not infer an affected group from a sector label."
    },
    "cross_cutting_theme": {
      "cardinality": "zero_or_more_open_values",
      "common_values": [
        "gender_equality",
        "children_and_youth",
        "disability_and_accessibility",
        "poverty_and_inequality",
        "livelihoods_and_jobs",
        "just_transition",
        "indigenous_or_local_knowledge",
        "capacity_building",
        "finance",
        "technology",
        "data_and_monitoring",
        "participation",
        "transboundary_cooperation",
        "nature_based_solutions"
      ],
      "rule": "Use a common value when it fits; otherwise retain a concise source-grounded theme. Do not repeat the domain or purpose as a theme."
    },
    "geographic_scope": {
      "cardinality": "zero_or_more",
      "values": [
        "local",
        "subnational",
        "national",
        "transboundary",
        "regional",
        "global"
      ],
      "rule": "Record only an explicit or unambiguous scope; the exact named place goes in places."
    },
    "places": {
      "cardinality": "zero_or_more_open_values",
      "shape": {
        "source_name": "exact source wording",
        "normalized_name": "optional normalized display name",
        "place_type": "country|region|district|city|basin|site|other|unknown"
      },
      "rule": "Never infer a place from country context when the statement is not geographically specific."
    },
    "stakeholders": {
      "cardinality": "zero_or_more",
      "shape": {
        "name": "exact source-stated actor or organization",
        "relationship": "responsible_for|implements|funds|supports|consulted|reports|monitors|represents|affected_by|benefits|other_as_stated",
        "evidence_id": "record evidence supporting this link"
      },
      "rule": "Affected groups and stakeholders are separate. Do not invent an actor or role."
    },
    "policy_status": {
      "cardinality": "zero_or_one",
      "values": [
        "existing_or_in_force",
        "approved_or_adopted",
        "under_implementation",
        "planned_or_proposed",
        "completed_or_delivered",
        "status_not_stated"
      ],
      "rule": "Use only for policy_or_action statements; status_not_stated may be omitted."
    }
  },
  "quantitative_information": {
    "cardinality": "zero_or_more_typed_facts",
    "fact_types": [
      "target",
      "observation",
      "projection",
      "finance",
      "other"
    ],
    "common_fields": [
      "fact_type",
      "metric",
