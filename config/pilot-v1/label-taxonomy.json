  },
  "unmapped_concepts": {
    "cardinality": "zero_or_more",
    "shape": {
      "source_term": "source wording",
      "proposed_label": "concise proposed topic or facet value",
      "reason": "why existing controlled values do not fit"
    },
    "rule": "Use when a useful concept genuinely does not fit. Do not create permanent IDs during extraction."
  },
  "source_record_shape": {
